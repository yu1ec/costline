{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Costline",
  "version": "0.1.0",
  "identifier": "com.costline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/yu1ec/costline/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQTU1NkQ1MDVCNzc1NzYKUldSMmRiY0YxVmFsZzFxcmtTa2dUbFljODl0a1JjbTNvNnFQV3FWdlFiV1Z3WExZOGozUm9PU20K"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Costline 盯盘",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "backgroundColor": "#0c0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Finance",
    "shortDescription": "股票 / 基金 / 黄金 回本盯盘",
    "longDescription": "Costline 是一个常驻菜单栏的盯盘工具，价格越过你的成本线时通过 Bark、Telegram、企业微信等渠道提醒你。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
