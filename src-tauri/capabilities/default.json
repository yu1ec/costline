{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Costline 主窗口与托盘下拉面板权限",
  "windows": ["main", "tray-panel"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
